#include <iostream>
#include <windows.h>

#include "Hub.h"
#include "Devices.h"

using namespace std;

int main()
{
SetConsoleCP(65001);
SetConsoleOutputCP(65001);

Hub hub;

AirConditioner airConditioner;
Humidifier humidifier;
Ventilation ventilation;

// Підключаємо пристрої до хаба
hub.addObserver(&airConditioner);
hub.addObserver(&humidifier);
hub.addObserver(&ventilation);

cout << "=== Перша змiна клiмату ===\n";
hub.setClimate(30, 35);

cout << "\n=== Вiдключаємо зволожувач ===\n";
hub.removeObserver(&humidifier);

cout << "\n=== Друга змiна клiмату ===\n";
hub.setClimate(20, 50);

return 0;
}
