#include "Hub.h"
#include <iostream>

using namespace std;

void Hub::addObserver(Observer* observer)
{
observers.push_back(observer);
}

void Hub::removeObserver(Observer* observer)
{
for (int i = 0; i < observers.size(); i++)
{
if (observers[i] == observer)
{
observers.erase(observers.begin() + i);
break;
}
}
}

void Hub::notifyObservers()
{
for (Observer* observer : observers)
{
observer->update(temperature, humidity);
}
}

void Hub::setClimate(float temperature, float humidity)
{
this->temperature = temperature;
this->humidity = humidity;

cout << "Змiна клiмату: "
<< temperature << " C, "
<< humidity << "%\n";

notifyObservers();
}
